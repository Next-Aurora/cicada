# MySQL (required for auth)
# On Vercel / serverless, prefer a pooler and keep connection_limit low, e.g.:
# mysql://user:password@host:3306/cicada?connection_limit=1
# `pnpm db:migrate` creates this database when it is missing (see prisma/create-database.sql).
DATABASE_URL="mysql://user:password@localhost:3306/cicada"

# Better Auth
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated extra origins (in addition to BETTER_AUTH_URL / cicadar.cn / localhost)
# AUTH_TRUSTED_ORIGINS="https://preview.example.com"
# Client idle auto sign-out after N minutes (default 10). Server session remains up to 24h with activity.
AUTH_IDLE_TIMEOUT_MINUTES="10"

# GitHub OAuth (optional until configured)
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# WeChat in-app browser login via mini program (optional).
# Identity is this mini program's openid. Open Platform certification is not required.
# Upload wechat-miniprogram/ and set its request domain to this site.
WECHAT_MINI_APP_ID=""
WECHAT_MINI_APP_SECRET=""
# release | trial | develop
# WECHAT_MINI_ENV_VERSION="release"
# WECHAT_MINI_LOGIN_PATH="pages/login/index"
