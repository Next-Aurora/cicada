# 复制为 .env 后供本地 `docker compose up` 使用（或直接在 Portainer 栈环境变量中配置）
# cp .env.docker .env

# 完整镜像地址。本地未设置时，docker-compose.override.yml 默认 cicada:local
# IMAGE_URI=crpi-xxxx.cn-chengdu.personal.cr.aliyuncs.com/your-ns/cicada:1.0.0

# 宿主机端口绑定（默认只听本机，方便前面挂 Nginx）
WEB_PORT=127.0.0.1:3000

# MySQL：若库在宿主机（scripts/mysql/deploy.sh），容器内用 host.docker.internal
DATABASE_URL=mysql://cicada:请填写密码@host.docker.internal:3306/cicada

# Better Auth
BETTER_AUTH_SECRET=请用 openssl rand -base64 32 生成
BETTER_AUTH_URL=https://你的域名
# AUTH_TRUSTED_ORIGINS=
# AUTH_IDLE_TIMEOUT_MINUTES=10

# 可选
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# WECHAT_MINI_APP_ID=
# WECHAT_MINI_APP_SECRET=
