# 复制到服务器（勿提交真实密钥）:
#   sudo mkdir -p /etc/cicadar
#   sudo cp scripts/nginx/dns-credentials.env.example /etc/cicadar/dns-credentials.env
#   sudo chmod 600 /etc/cicadar/dns-credentials.env
#   sudo nano /etc/cicadar/dns-credentials.env
#
# 然后（大陆请加 --china）:
#   sudo bash scripts/nginx/enable-https-wildcard.sh --email you@example.com --china
# 完整说明: scripts/nginx/README.md

# 解析商：aliyun | dnspod | tencent | cloudflare
DNS_PROVIDER=dnspod

# --- 阿里云 DNS（云解析 DNS）---
# 控制台 → AccessKey；建议用仅含「云解析」权限的子账号 RAM
# Ali_Key=
# Ali_Secret=

# --- DNSPod Token（API 2.0，对应本脚本 DNS_PROVIDER=dnspod）---
# 控制台: https://console.dnspod.cn/account/token/
# 路径: 账号中心 → 密钥管理 → 创建密钥 → 选「DNSPod Token」
# 创建后只显示一次: ID → DP_Id，Token → DP_Key（勿把二者用逗号拼成一串填进某一项）
# 文档: https://docs.dnspod.cn/account/dnspod-token/
# DP_Id=
# DP_Key=
#
# 若你只有腾讯云 API 密钥（SecretId/SecretKey），改用:
# DNS_PROVIDER=tencent
# Tencent_SecretId=
# Tencent_SecretKey=

# --- 腾讯云 DNS（DNSPod 新版 API，部分账号用这个）---
# Tencent_SecretId=
# Tencent_SecretKey=

# --- Cloudflare ---
# 推荐 API Token（Zone.DNS Edit）:
# CF_Token=
# 或 Global API Key:
# CF_Key=
# CF_Email=
