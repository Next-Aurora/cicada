{
  "mcpServers": {
    "open-meteo": {
      "command": "npx",
      "args": ["-y", "-p", "open-meteo-mcp-server", "open-meteo-mcp-server"]
    },
    "x-mcp": {
      "url": "https://mcp.aredink.com/mcp",
      "headers": {
        "X-API-Key": "<YOUR_XHS_TOKEN>"
      }
    },
    "tencent-docs": {
      "url": "https://docs.qq.com/openapi/mcp",
      "headers": {
        "Authorization": "<YOUR_TENCENT_DOCS_TOKEN>"
      }
    }
  }
}
